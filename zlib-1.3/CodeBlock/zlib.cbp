<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="zlib" />
		<Option pch_mode="2" />
		<Option compiler="microsoft_visual_c_60" />
		<Build>
			<Target title="ICL 9">
